# Email delivery for orders, quotes, contact, warranty and newsletter forms.
# Set these in Vercel > Project > Settings > Environment Variables (never commit real values).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sales@barfreezer.com.au

# Where each form type is delivered (all optional; default to the addresses in src/config/site.js)
ORDER_EMAIL=
QUOTE_EMAIL=
CONTACT_EMAIL=
SERVICE_EMAIL=

# Optional backup copy of every submission (Upstash Redis REST / Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reply Portal admin dashboard (/admin/) passcode. Server-only; set a long random value.
ADMIN_PASSCODE=
